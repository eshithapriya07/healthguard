# ------------------------------------------------------------------
# HealthGuard backend configuration
# Copy this file to .env and adjust the values for your machine.
# ------------------------------------------------------------------

# --- HTTP server ---
PORT=4000
NODE_ENV=development
# Comma separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# --- MySQL 8 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthguard
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Any long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Set to true only behind HTTPS
COOKIE_SECURE=false

# --- Password reset ---
# demo mode returns the reset token in the API response (no SMTP required)
RESET_TOKEN_DEMO_MODE=true
RESET_TOKEN_TTL_MINUTES=30

# --- Optional e-mail notifications (alerts/reminders) ---
# Leave EMAIL_ENABLED=false to run fully without SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=567
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HealthGuard <no-reply@healthguard.local>

# --- Optional AI chatbot (OpenAI-compatible). Falls back to the built-in
# --- rule-based bot when the key is missing.
AI_ENABLED=false
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Cron (reminders + share expiry) : default every minute ---
CRON_SCHEDULE=*/1 * * * *
CRON_ENABLED=true
